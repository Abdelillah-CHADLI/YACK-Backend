# =====================================================================
# YACK Backend — Environment Variables
# Copy this file to `.env` and fill in YOUR OWN values (never commit .env).
# =====================================================================

# --- Server ---
# Port the Express server listens on. Defaults to 80 (used by Leapcell).
# For local development you may want PORT=3000.
PORT=80

# --- Behavior ---
# Production (NODE_ENV=production) REFUSES to start when a required variable is
# missing. Local development continues with warnings. Set:
#   NODE_ENV=production            (on Leapcell/Render)
# Dev on your machine: leave NODE_ENV unset or set to "development".

# --- MongoDB ---
# MongoDB Atlas connection string (replace with your own cluster).
# For a local Mongo instance: mongodb://127.0.0.1:27017/yack
MONGO_URI=mongodb://127.0.0.1:27017/yack

# --- Firebase Admin (Auth + Cloud Messaging) ---
# From your Firebase project -> Project settings -> Service accounts -> Generate new private key.
# NOTE: FIREBASE_PRIVATE_KEY must contain literal \n newlines (keep the escaped form).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv....\n-----END PRIVATE KEY-----\n"

# Alternative to the three FIREBASE_* vars above: point at a service-account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
# Note: the old implicit `serviceAccountKey.json` next to src/config was removed;
# credentials are only ever taken from the env vars or GOOGLE_APPLICATION_CREDENTIALS.

# --- CORS ---
# Comma-separated browser origins allowed to call this API (F-68).
# REQUIRED in production; when missing, cross-origin browser access is refused
# (fail closed). Example for the deployed admin dashboard:
# CORS_ORIGINS=https://yack-admin.your-domain.com,https://yack-admin.onrender.com
# Native mobile clients are unaffected (they send no Origin header).
CORS_ORIGINS=https://yack-admin.example.com

# --- Admin dashboard ---
# Comma-separated verified Firebase Auth accounts allowed to use /admin routes.
# Required in production (fail-fast if missing).
ADMIN_EMAILS=admin@example.com
# Public half of the contract-review key generated by the YACK-Admin project
# (scripts/generate-admin-review-key.mjs). The matching private key lives at
# ~/.config/yack-admin/admin-review-private-key.pem, outside the repo, and is
# never placed on the server. Required in production.
ADMIN_REVIEW_PUBLIC_KEY=base64-encoded-yack-rsa-public-key

# --- Cloudinary (media/file storage) ---
# From your Cloudinary dashboard (Dashboard -> account details, and API Keys page).
# The cloud name, API key and API secret are required in production; a
# connectivity ping runs at boot to catch bad credentials early (not fatal).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
